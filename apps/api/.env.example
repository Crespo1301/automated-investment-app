# Runtime posture
INVESTMENT_APP_ENVIRONMENT=development
INVESTMENT_APP_TRADING_MODE=paper
INVESTMENT_APP_BASE_CURRENCY=USD

# Confirmed first watchlist
INVESTMENT_APP_ALLOWED_SYMBOLS=SPY,QQQ,NVDA,TSLA,AAPL

# Starter guardrails
INVESTMENT_APP_MAX_NOTIONAL_PER_TRADE=2
INVESTMENT_APP_MAX_OPEN_POSITIONS=1
INVESTMENT_APP_MAX_LIVE_TRADES_PER_DAY=3
INVESTMENT_APP_MAX_DAILY_LOSS=2
INVESTMENT_APP_ALLOW_LIVE_TRADING=false
INVESTMENT_APP_ALLOW_OUTSIDE_MARKET_HOURS=false
INVESTMENT_APP_DUPLICATE_ORDER_LOOKBACK_MINUTES=390
INVESTMENT_APP_RUNTIME_DATA_DIR=.runtime

# Alpaca. Use paper keys first. Add live keys only when ready.
INVESTMENT_APP_ALPACA_API_KEY=replace-with-your-alpaca-key
INVESTMENT_APP_ALPACA_SECRET_KEY=replace-with-your-alpaca-secret
INVESTMENT_APP_ALPACA_PAPER=true

# OpenAI. Rotate any key that has been pasted into chat before using it here.
INVESTMENT_APP_OPENAI_API_KEY=replace-with-your-openai-key
INVESTMENT_APP_OPENAI_MODEL=gpt-5.4-mini
